# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment (used to build the webhook URL shown in
# Settings, and as the magic-link redirect target)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret used only for the WhatsApp Cloud API webhook verification
# handshake (GET request). Set the same value when registering the webhook
# in the Meta App dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Per-account Meta Pixel ID / CAPI access token and WhatsApp phone_number_id
# are configured per user inside the app (Settings page), not here.
